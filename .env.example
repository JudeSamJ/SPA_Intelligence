# Copy to .env and fill in. .env is gitignored: never commit real keys.
LLM_PROVIDER=azure_openai

# --- Azure OpenAI ---
AZURE_OPENAI_API_KEY=
# Either https://YOUR-RESOURCE.openai.azure.com/ or the Foundry v1 form https://YOUR-RESOURCE.services.ai.azure.com/openai/v1/
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com/
# The *deployment name* from the Azure portal (model gpt-5.4-mini, version 2026-03-17). Often the same as the model name.
AZURE_OPENAI_DEPLOYMENT=gpt-5.4-mini
# Only for classic *.openai.azure.com endpoints. NOT the model version. Ignored for Foundry v1 endpoints
# (*.services.ai.azure.com or .../openai/v1/), which need no api-version.
AZURE_OPENAI_API_VERSION=2025-04-01-preview

# --- Safety cap on LLM calls per app/script process (protects a shared company key) ---
LLM_MAX_CALLS=40

# --- Optional: Anthropic instead (set LLM_PROVIDER=anthropic) ---
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
