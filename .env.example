# Copy to .env and fill in. .env is gitignored: never commit real keys. Keys stay on the SERVER; the browser never sees them.
LLM_PROVIDER=azure_openai

# --- Azure OpenAI ---
AZURE_OPENAI_API_KEY=
# Classic: https://YOUR-RESOURCE.openai.azure.com/   or Foundry v1: https://YOUR-RESOURCE.services.ai.azure.com/openai/v1/
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com/
# The *deployment name* from the Azure portal (model gpt-5.4-mini, version 2026-03-17). Often the same as the model name.
AZURE_OPENAI_DEPLOYMENT=gpt-5.4-mini
# Only for classic *.openai.azure.com endpoints (NOT the model version). Ignored for Foundry v1 endpoints.
AZURE_OPENAI_API_VERSION=2025-04-01-preview

# --- Safety cap on LLM calls per server process (protects a shared company key) ---
LLM_MAX_CALLS=40

# --- API server ---
# Explicit origins only (never *). Comma-separated.
CORS_ORIGINS=http://localhost:5173
# Set to 1 to serve frontend/dist from the API (single-process production-style run)
SERVE_FRONTEND=0
# In-memory rate limits: requests per minute per client IP
RATE_UPLOADS=10
RATE_CHAT=30

# --- Optional: Anthropic instead (set LLM_PROVIDER=anthropic) ---
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
