# Copy to .env and fill in. .env is gitignored: never commit real keys. Keys stay on the SERVER; the browser never sees them.
LLM_PROVIDER=azure_openai

# --- Azure OpenAI ---
AZURE_OPENAI_API_KEY=
# Classic: https://YOUR-RESOURCE.openai.azure.com/   or Foundry v1: https://YOUR-RESOURCE.services.ai.azure.com/openai/v1/
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com/
# The *deployment name* from the Azure portal (model gpt-5.4-mini, version 2026-03-17). Often the same as the model name.
AZURE_OPENAI_DEPLOYMENT=gpt-5.4-mini
# Only for classic *.openai.azure.com endpoints (NOT the model version). Ignored for Foundry v1 endpoints.
AZURE_OPENAI_API_VERSION=2025-04-01-preview

# --- Safety cap on LLM calls per server process (protects a shared company key) ---
LLM_MAX_CALLS=40

# --- API server ---
# Explicit origins only (never *). Comma-separated.
CORS_ORIGINS=http://localhost:5173
# Set to 1 to serve frontend/dist from the API (single-process production-style run)
SERVE_FRONTEND=0
# In-memory rate limits: requests per minute per client IP
RATE_UPLOADS=10
RATE_CHAT=30

# --- Optional: Anthropic instead (set LLM_PROVIDER=anthropic) ---
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Optional engines for the extraction bake-off (an engine without these is reported "not configured") ---
# AZURE_DOCINT_ENDPOINT=https://YOUR-DOCINT.cognitiveservices.azure.com/
# AZURE_DOCINT_KEY=
# docling: pip install docling

# --- Buyer chat (token auth STUB: token -> contract id). JSON or token=id,token2=id2. Tokens need >= 8 characters. ---
# BUYER_TOKENS={"a-long-random-token":"<64-hex contract id from GET /api/contracts>"}

# --- D365 F&O push (OFF by default; dry-run export always works). Names in erp/d365_mapping.yaml are placeholders. ---
# ERP_PUSH_ENABLED=1
# D365_TENANT_ID=
# D365_CLIENT_ID=
# D365_CLIENT_SECRET=
# D365_RESOURCE=https://YOUR-ENV.operations.dynamics.com

# --- Statute rate tables / overrides ---
# SPA_RATES_DIR=            # default rules/rates (edit rules/rates/sbi_mclr.yaml; the shipped file is empty on purpose)
# SPA_DISABLE_SCHEDULER=1   # turn off the daily obligation recompute (APScheduler)

# --- Microsoft Entra sign-in for the API (default off = local development only). See docs/entra-setup.md ---
# AUTH_MODE=entra
# ENTRA_TENANT_ID=
# ENTRA_CLIENT_ID=
# BUYER_ACCOUNTS={"<buyer entra object id>":"<64-hex contract id>"}

# --- Power Automate webhook (optional): a flow starting with "When an HTTP request is received" ---
# ALERT_WEBHOOK_URL=
# ALERT_WEBHOOK_SECRET=
