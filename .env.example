# Copy to .env and fill in. .env is gitignored: never commit real keys.
LLM_PROVIDER=azure_openai

# --- Azure OpenAI ---
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com/
# The *deployment name* from the Azure portal (model gpt-5.4-mini, version 2026-03-17). Often the same as the model name.
AZURE_OPENAI_DEPLOYMENT=gpt-5.4-mini
# Use the API version shown in your Azure portal if this one is rejected.
AZURE_OPENAI_API_VERSION=2025-04-01-preview

# --- Safety cap on LLM calls per app/script process (protects a shared company key) ---
LLM_MAX_CALLS=40

# --- Optional: Anthropic instead (set LLM_PROVIDER=anthropic) ---
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
